# Dunst Configuration - Shared Core Configuration
# Managed by GNU Stow - changes here sync across machines
# Beautiful, premium glassmorphism/Catppuccin Mocha aesthetic

[global]
    # Typography & Styling
    font = Inter, Hack Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    
    # Alignment and Geometry
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    
    # Geometry
    width = 350
    height = 150
    origin = top-right
    offset = 20x50 # Offset slightly down from the top panel
    
    # Progress bar styling
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    # Interaction & Life
    shrink = no
    transparency = 10
    notification_limit = 5
    idle_threshold = 120
    
    # Border & Rounding
    corner_radius = 12
    frame_width = 1
    frame_color = #313244
    separator_color = frame
    
    # Miscellaneous
    play_sound = no
    enable_posix_regex = true

# Theme Colors (Catppuccin Mocha Slate style)
[urgency_low]
    background = #1e1e2e
    foreground = #cdd6f4
    timeout = 5
    default_icon = 󰇮

[urgency_normal]
    background = #1e1e2e
    foreground = #cdd6f4
    frame_color = #89b4fa
    timeout = 10
