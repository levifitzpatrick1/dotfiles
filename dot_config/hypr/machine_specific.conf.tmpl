# Host-specific Hyprland settings.
# Keep monitor layout, workspace placement, and hardware-specific startup here.

{{- if eq .chezmoi.hostname "Zerrik" }}
# Desktop: Zerrik
# Detected DRM connectors on setup day:
#   DP-1, HDMI-A-1, DP-2, DP-3, DP-4, HDMI-A-2
# Replace these generic rules with explicit positions/rates once you know the
# exact Hyprland connector names from: hyprctl monitors all
monitor = , preferred, auto, 1

# Example explicit layout, edit when ready:
# monitor = DP-1, 2560x1440@165, 0x0, 1
# monitor = HDMI-A-1, 1920x1080@60, 2560x0, 1
# workspace = 1, monitor:DP-1, default:true
# workspace = 2, monitor:DP-1
# workspace = 3, monitor:HDMI-A-1

{{- else if eq .chezmoi.hostname "laptop-hostname" }}
# Laptop
# Rename laptop-hostname after running: cat /proc/sys/kernel/hostname
monitor = eDP-1, preferred, 0x0, 1
monitor = , preferred, auto, 1

workspace = 1, monitor:eDP-1, default:true
workspace = 2, monitor:eDP-1
workspace = 3, monitor:eDP-1

{{- else }}
# Fallback for new machines.
monitor = , preferred, auto, 1
{{- end }}
