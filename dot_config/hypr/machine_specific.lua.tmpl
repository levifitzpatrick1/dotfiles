{{- else if eq .chezmoi.hostname "laptop-hostname" }}
-- Laptop
-- Rename laptop-hostname after running: cat /proc/sys/kernel/hostname
hl.monitor({
    output = "eDP-1",
    mode = "preferred",
    position = "0x0",
    scale = 1,
})

hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = 1,
})

hl.workspace_rule({ workspace = "1", monitor = "eDP-1", default = true })
hl.workspace_rule({ workspace = "2", monitor = "eDP-1" })
hl.workspace_rule({ workspace = "3", monitor = "eDP-1" })

{{- else }}
-- Fallback for new machines.
hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = 1,
})
{{- end }}
