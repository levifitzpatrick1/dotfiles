#!/bin/sh
set -eu

source_dir="$HOME/.config/quickshell-games"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-tools"
binary="$cache_dir/game-launcher"

mkdir -p "$cache_dir"

rebuild=0
if [ ! -x "$binary" ]; then
  rebuild=1
elif find "$source_dir" \( -name "*.go" -o -name "go.mod" \) -newer "$binary" | grep -q .; then
  rebuild=1
fi

if [ "$rebuild" -eq 1 ]; then
  temporary="$binary.tmp"
  (cd "$source_dir" && go build -o "$temporary")
  mv "$temporary" "$binary"
fi

exec "$binary" "$@"

