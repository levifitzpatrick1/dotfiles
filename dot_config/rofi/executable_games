#!/bin/sh
set -eu

source_file="$HOME/.config/rofi/games.go"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-tools"
binary="$cache_dir/game-launcher"

mkdir -p "$cache_dir"
if [ ! -x "$binary" ] || [ "$source_file" -nt "$binary" ]; then
  temporary="$binary.tmp"
  go build -o "$temporary" "$source_file"
  mv "$temporary" "$binary"
fi

exec "$binary" "$@"
