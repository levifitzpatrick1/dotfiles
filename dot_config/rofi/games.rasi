@import "~/.config/themes/current/colors.rasi"

* {
    font: "Comfortaa 13";
    radius: 28px;
    background-color: transparent;
    text-color: @foreground;
}

window {
    fullscreen: true;
    transparency: "real";
    background-color: @background; /* Transparent blur background */
    
    /* Center the main menu horizontally on the screen */
    orientation: horizontal;
    children: [ "dummy", "mainbox", "dummy" ];
}

mainbox {
    width: 1560px; /* Keep the menu compact and avoid stretching on ultrawide screens */
    padding: 80px 0px;
    spacing: 20px;
    children: [ "prompt", "inputbar-box", "listview" ];
}

prompt {
    text-color: @selected;
    font: "Comfortaa Bold 32";
    margin: 0px 0px 10px 10px;
}

inputbar-box {
    children: [ "dummy", "inputbar", "dummy" ];
    orientation: horizontal;
    expand: false;
}

inputbar {
    children: [ "entry" ];
    margin: 0px;
    padding: 12px 24px;
    background-color: @background-alt;
    border: 1px;
    border-color: @edge;
    border-radius: 16px;
    width: 420px;
}

entry {
    placeholder: "Search games...";
    placeholder-color: @foreground-muted;
    horizontal-align: 0.5;
    text-color: @foreground;
}

listview {
    columns: 6;
    lines: 2;
    spacing: 16px; /* Tight, compact spacing between cards! */
    padding: 10px 0px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
}

element {
    children: [ "dummy", "element-box", "dummy" ];
    orientation: vertical;
    padding: 8px; /* Tighter padding for a cleaner border fit! */
    border: 1px;
    border-color: transparent;
    border-radius: 20px;
    background-color: transparent;
    cursor: pointer;
}

element selected.normal {
    background-color: @background-hover;
    border-color: @selected;
}

element-box {
    children: [ "element-icon", "element-text" ];
    orientation: vertical;
    expand: false;
}

element-icon {
    size: 280px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    border-radius: 14px; /* Slightly tighter rounding for the box art */
}

element-text {
    font: "Comfortaa Bold 11"; /* Slightly smaller font for a cleaner look */
    horizontal-align: 0.5;
    text-color: @foreground;
    margin: 6px 0px 0px 0px;
}

element selected.normal element-text {
    text-color: @selected;
}

error-message {
    padding: 20px;
    border: 1px;
    border-color: @urgent;
    border-radius: 20px;
    background-color: @background-alt;
}
