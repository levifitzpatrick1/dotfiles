/* Rofi Launcher Config - Clean Modern Glassmorphism */

@import "~/.config/themes/current/colors.rasi"

* {
    font: "Inter 12";
    radius: 16px;
}

window {
    location: center;
    anchor: center;
    width: 650px;
    border: 2px;
    border-color: @edge;
    border-radius: @radius;
    background-color: @background;
    transparency: "real";
}

mainbox {
    padding: 24px;
    spacing: 16px;
    background-color: transparent;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    padding: 14px 18px;
    spacing: 12px;
    border: 1px;
    border-color: @edge;
    border-radius: @radius;
    background-color: @background-alt;
    text-color: @foreground;
    children: [ "prompt", "entry" ];
}

prompt {
    enabled: true;
    background-color: transparent;
    text-color: @foreground;
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "Search apps or calculate math...";
    placeholder-color: @foreground-muted;
    cursor: text;
}

message {
    enabled: true;
    margin: 0px;
    padding: 0px;
    border-radius: @radius;
    background-color: transparent;
}

textbox {
    padding: 12px 16px;
    border-radius: @radius;
    background-color: @background-soft;
    text-color: @foreground;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    fixed-columns: true;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    spacing: 8px;
    margin: 4px 0px 0px 0px;
    padding: 0px;
    background-color: transparent;
    text-color: @foreground;
}

element {
    padding: 12px 16px;
    spacing: 16px;
    border: 0px;
    border-radius: @radius;
    background-color: transparent;
    text-color: @foreground;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @background-hover;
    text-color: #ffffff;
    border: 1px;
    border-color: @edge;
}

element normal.active {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.active {
    background-color: transparent;
    text-color: @foreground;
}

element selected.active {
    background-color: @background-hover;
    text-color: #ffffff;
}

element normal.urgent {
    background-color: rgba(243, 139, 168, 0.15);
    text-color: #ffffff;
}

element alternate.urgent {
    background-color: rgba(243, 139, 168, 0.15);
    text-color: #ffffff;
}

element selected.urgent {
    background-color: #f38ba8;
    text-color: #000000;
}

element-icon {
    size: 28px;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

error-message {
    padding: 16px;
    border: 2px;
    border-color: @urgent;
    border-radius: @radius;
    background-color: @background;
    text-color: @foreground;
}
