@import "~/.config/themes/current/colors.rasi"

* {
    font: "Comfortaa 12";
    radius: 24px;
    background-color: transparent;
    text-color: @foreground;
}

window {
    location: center;
    anchor: center;
    width: 680px;
    border: 1px;
    border-color: @edge;
    border-radius: @radius;
    background-color: @background;
    transparency: "real";
}

mainbox {
    padding: 24px;
    spacing: 16px;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    padding: 14px 18px;
    spacing: 12px;
    border: 1px;
    border-color: @edge;
    border-radius: 16px;
    background-color: @background-alt;
    text-color: @foreground;
    children: [ "prompt", "entry" ];
}

prompt {
    padding: 0px 2px 0px 0px;
    text-color: @selected;
}

entry {
    background-color: transparent;
    text-color: inherit;
    placeholder: "Search apps...";
    placeholder-color: @foreground-muted;
    cursor: text;
}

message {
    padding: 0px;
    margin: 0px;
}

textbox {
    padding: 12px 16px;
    border-radius: 14px;
    background-color: @background-soft;
}

listview {
    lines: 8;
    columns: 2;
    fixed-height: true;
    fixed-columns: true;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    spacing: 8px;
    margin: 0px;
    padding: 4px 0px 0px 0px;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border: 1px;
    border-color: transparent;
    border-radius: 14px;
    background-color: transparent;
    cursor: pointer;
}

element selected.normal,
element selected.active {
    background-color: @background-hover;
    border-color: @selected;
    text-color: @selected;
}

element normal.urgent,
element alternate.urgent {
    background-color: @background-soft;
    text-color: @urgent;
}

element-icon {
    size: 32px;
}

element-text {
    vertical-align: 0.5;
}

error-message {
    padding: 16px;
    border: 1px;
    border-color: @urgent;
    border-radius: @radius;
    background-color: @background;
}
