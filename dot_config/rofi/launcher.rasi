* {
    font: "Iosevka Nerd Font 12";
    background: #1e1e2eff;
    background-alt: #181825ff;
    foreground: #cdd6f4ff;
    selected: #cba6f7ff;
    active: #89b4faff;
    urgent: #f38ba8ff;
    background-soft: #313244ff;
    background-hover: #45475aff;
    foreground-muted: #a6adc8ff;
    edge: #b4befeff;
    radius: 12px;
}

window {
    location: center;
    anchor: center;
    width: 680px;
    border: 1px;
    border-color: @edge;
    border-radius: @radius;
    background-color: @background;
    transparency: "real";
}

mainbox {
    padding: 18px;
    spacing: 12px;
    background-color: transparent;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    padding: 12px 14px;
    spacing: 10px;
    border: 1px;
    border-color: @background-hover;
    border-radius: @radius;
    background-color: @background-soft;
    text-color: @foreground;
    children: [ "prompt", "entry" ];
}

prompt {
    enabled: true;
    padding: 0px 4px 0px 0px;
    background-color: transparent;
    text-color: @selected;
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "Search apps, commands, files";
    placeholder-color: @foreground-muted;
    cursor: text;
}

message {
    enabled: true;
    margin: 0px;
    padding: 0px;
    border-radius: @radius;
    background-color: transparent;
}

textbox {
    padding: 10px 12px;
    border-radius: @radius;
    background-color: @background-soft;
    text-color: @foreground;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    fixed-columns: true;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    spacing: 6px;
    margin: 0px;
    padding: 0px;
    background-color: transparent;
    text-color: @foreground;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border: 0px;
    border-radius: @radius;
    background-color: transparent;
    text-color: @foreground;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @background-hover;
    text-color: @foreground;
}

element normal.active {
    background-color: @background-hover;
    text-color: @active;
}

element alternate.active {
    background-color: @background-hover;
    text-color: @active;
}

element selected.active {
    background-color: @background-hover;
    text-color: @active;
}

element normal.urgent {
    background-color: @background-hover;
    text-color: @urgent;
}

element alternate.urgent {
    background-color: @background-hover;
    text-color: @urgent;
}

element selected.urgent {
    background-color: @background-hover;
    text-color: @urgent;
}

element-icon {
    size: 32px;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

error-message {
    padding: 12px;
    border: 1px;
    border-color: @urgent;
    border-radius: @radius;
    background-color: @background;
    text-color: @foreground;
}
