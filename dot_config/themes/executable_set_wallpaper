#!/bin/bash
set -eu

if [ -z "${1:-}" ]; then
  echo "Usage: set_wallpaper <path/to/wallpaper.jpg>"
  exit 1
fi

wallpaper_path="$1"

# Generate theme from the image
python3 "$HOME/.config/themes/generate_theme.py" "$wallpaper_path"

# Reload wallpaper in swww or hyprpaper
if command -v swww >/dev/null 2>&1; then
  if ! pgrep -x swww-daemon >/dev/null; then
    swww-daemon --format xrgb &
    sleep 0.5
  fi
  swww img "$HOME/.config/themes/current/background.jpg" --transition-type outer --transition-fps 60 --transition-step 10 || true
elif pgrep -x hyprpaper >/dev/null; then
  hyprctl hyprpaper unload all || true
  hyprctl hyprpaper preload "$HOME/.config/themes/current/background.jpg" || true
  hyprctl hyprpaper wallpaper "DP-2,$HOME/.config/themes/current/background.jpg" || true
fi

# Reload waybar (signals waybar to reload style/css)
killall -USR2 waybar || true

# Reload swaync client if running
if pgrep -x swaync >/dev/null; then
  swaync-client -R || true
fi

echo "Wallpaper and theme applied successfully!"
